BASE_URL=http://localhost:8000
API_KEY=your-api-key-here
RESTAURANT_ID=1
TURN_ID=
POLLING_MODE=normal
UI_PORT=8080

# MySQL bridge — reads events written by main.py agent (same defaults as docker-compose)
MYSQL_ENABLED=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=appuser
MYSQL_PASSWORD=apppassword
MYSQL_DB=hackapizza
MYSQL_POLL_INTERVAL_S=1.0
